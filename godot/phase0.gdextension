[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.5
reloadable = true

[libraries]

linux.debug.x86_64 = "res://../target/debug/libclient_ext.so"
linux.release.x86_64 = "res://../target/release/libclient_ext.so"
windows.debug.x86_64 = "res://../target/debug/client_ext.dll"
windows.release.x86_64 = "res://../target/release/client_ext.dll"
macos.debug = "res://../target/debug/libclient_ext.dylib"
macos.release = "res://../target/release/libclient_ext.dylib"
macos.debug.arm64 = "res://../target/debug/libclient_ext.dylib"
macos.release.arm64 = "res://../target/release/libclient_ext.dylib"
